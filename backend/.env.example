# Tokens the mobile apps send as "Authorization: Bearer <token>" (comma-separated).
APP_API_KEYS=change-me

# Claude (gist, replies, composing). Read by the Anthropic SDK.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Speech-to-text: any provider exposing an OpenAI-compatible
# POST {STT_BASE_URL}/audio/transcriptions endpoint.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

MAX_AUDIO_MB=25
